def set_seed(seed: int) -> None:
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)


def resolve_device(value: str) -> torch.device:
    if value == "auto":
        return torch.device("cuda:0" if torch.cuda.is_available() else "cpu")
    device = torch.device(value)
    if device.type == "cuda" and not torch.cuda.is_available():
        raise RuntimeError("CUDA was requested but is unavailable.")
    return device


def add_repo_src(repo_root: Path) -> None:
    src = repo_root / "src"
    if not src.exists():
        raise FileNotFoundError(f"PatchCore source directory not found: {src}")
    sys.path.insert(0, str(src))


def build_patchcore_model(device: torch.device):
    import patchcore.backbones as backbones
    import patchcore.common as common
    import patchcore.patchcore as patchcore_module
    import patchcore.sampler as sampler

    backbone = backbones.load("wideresnet50")
    backbone.name = "wideresnet50"

    model = patchcore_module.PatchCore(device)
    model.load(
        backbone=backbone,
        layers_to_extract_from=["layer2", "layer3"],
        device=device,
        input_shape=(3, 224, 224),
        pretrain_embed_dimension=1024,
        target_embed_dimension=1024,
        patchsize=3,
        patchstride=1,
        anomaly_score_num_nn=1,
        featuresampler=sampler.IdentitySampler(),
        nn_method=common.FaissNN(
            on_gpu=device.type == "cuda",
            num_workers=4,
        ),
    )
    model.eval()
    return model


def build_loaders(
    data_root: Path,
    category: str,
    batch_size: int,
    num_workers: int,
    seed: int,
):
    from patchcore.datasets import mvtec

    train_dataset = mvtec.MVTecDataset(
        source=str(data_root),
        classname=category,
        resize=256,
        train_val_split=1,
        imagesize=224,
        split=mvtec.DatasetSplit.TRAIN,
        seed=seed,
        augment=False,
    )
    test_dataset = mvtec.MVTecDataset(
        source=str(data_root),
        classname=category,
        resize=256,
        imagesize=224,
        split=mvtec.DatasetSplit.TEST,
        seed=seed,
    )

    loader_args = {
        "batch_size": batch_size,
        "num_workers": num_workers,
        "pin_memory": torch.cuda.is_available(),
        "shuffle": False,
    }

    return (
        train_dataset,
        test_dataset,
        DataLoader(train_dataset, **loader_args),
        DataLoader(test_dataset, **loader_args),
    )


def extract_patch_embeddings(
    model,
    images: torch.Tensor,
) -> Tuple[np.ndarray, Tuple[int, int]]:
    images = images.to(model.device)

    with torch.no_grad():
        embeddings, patch_shapes = model._embed(
            images,
            detach=True,
            provide_patch_shapes=True,
        )

    embeddings = np.asarray(embeddings, dtype=np.float32)
    patch_height, patch_width = patch_shapes[0]
    embeddings = embeddings.reshape(
        images.shape[0],
        patch_height * patch_width,
        -1,
    )
    return embeddings, (patch_height, patch_width)


def masks_to_patch_labels(
    masks: torch.Tensor,
    patch_grid: Tuple[int, int],
    anomaly_fraction_threshold: float,
) -> np.ndarray:
    if not torch.is_tensor(masks):
        masks = torch.as_tensor(masks)

    masks = masks.float()
    if masks.ndim == 3:
        masks = masks.unsqueeze(1)

    anomaly_fraction = F.adaptive_avg_pool2d(
        masks,
        output_size=patch_grid,
    ).squeeze(1)

    return (
        anomaly_fraction >= anomaly_fraction_threshold
    ).cpu().numpy()


def safe_text(value) -> str:
    if torch.is_tensor(value):
        value = value.item()
    return str(value)


def collect_nominal_training_features(
    model,
    train_loader: DataLoader,
) -> np.ndarray:
    batches: List[np.ndarray] = []

    for batch_index, batch in enumerate(train_loader):
        embeddings, _ = extract_patch_embeddings(model, batch["image"])
        batches.append(
            embeddings.reshape(-1, embeddings.shape[-1])
        )

        if (batch_index + 1) % 10 == 0 or batch_index + 1 == len(train_loader):
            print(
                f"[training features] "
                f"{batch_index + 1}/{len(train_loader)}"
            )

    if not batches:
        raise RuntimeError("No nominal training features were extracted.")

    return np.concatenate(batches, axis=0).astype(np.float32)


def subsample_nominal_reference(
    features: np.ndarray,
    mode: str,
    percentage: float,
    max_patches: int,
    seed: int,
    device: torch.device,
) -> Tuple[np.ndarray, np.ndarray]:
    number_of_features = len(features)

    if mode == "none":
        indices = np.arange(number_of_features, dtype=np.int64)
        return features, indices

    if mode == "random":
        target_size = (
            number_of_features
            if max_patches <= 0
            else min(max_patches, number_of_features)
        )
        rng = np.random.default_rng(seed)
        indices = rng.choice(
            number_of_features,
            size=target_size,
            replace=False,
        ).astype(np.int64)
        return features[indices], indices

    if mode == "coreset":
        import patchcore.sampler as sampler

        effective_percentage = percentage
        if max_patches > 0:
            effective_percentage = min(
                effective_percentage,
                max_patches / number_of_features,
            )

        effective_percentage = min(
            max(effective_percentage, 1.0 / number_of_features),
            1.0,
        )

        selector = sampler.ApproximateGreedyCoresetSampler(
            percentage=effective_percentage,
            device=device,
        )

        selected = np.asarray(
            selector.run(features),
            dtype=np.float32,
        )

        stored_indices = getattr(
            selector,
            "last_selected_indices",
            None,
        )

        if stored_indices is not None:
            indices = np.asarray(
                stored_indices,
                dtype=np.int64,
            )
        else:
            # Upstream PatchCore may not expose selected indices. Recover them by
            # exact row matching. This is used only for reproducibility/output.
            from sklearn.neighbors import NearestNeighbors

            finder = NearestNeighbors(
                n_neighbors=1,
                metric="euclidean",
                n_jobs=-1,
            )
            finder.fit(features)
            distances, recovered = finder.kneighbors(
                selected,
                return_distance=True,
            )

            if not np.allclose(
                distances[:, 0],
                0.0,
                atol=1e-6,
            ):
                raise RuntimeError(
                    "Could not recover exact coreset row indices. "
                    "Modify ApproximateGreedyCoresetSampler to save "
                    "last_selected_indices."
                )

            indices = recovered[:, 0].astype(np.int64)

        return selected, indices

    raise ValueError(f"Unknown subsampling mode: {mode}")


def collect_test_features_and_labels(
    model,
    test_loader: DataLoader,
    anomaly_fraction_threshold: float,
) -> Tuple[np.ndarray, np.ndarray, pd.DataFrame]:
    """
    Returns
    -------
    features:
        Shape [number_of_test_patches, feature_dimension].
    labels:
        One string label per patch: "nominal" or a defect type.
    metadata:
        image index, patch index, patch row/column, and source anomaly label.
    """
    feature_batches: List[np.ndarray] = []
    label_batches: List[np.ndarray] = []
    metadata_rows: List[Dict[str, object]] = []

    global_image_index = 0

    for batch_index, batch in enumerate(test_loader):
        embeddings, patch_grid = extract_patch_embeddings(
            model,
            batch["image"],
        )
        patch_labels = masks_to_patch_labels(
            batch["mask"],
            patch_grid,
            anomaly_fraction_threshold,
        )

        patch_height, patch_width = patch_grid

        for image_index in range(embeddings.shape[0]):
            defect_type = safe_text(
                batch["anomaly"][image_index]
            )
            is_defective_patch = patch_labels[
                image_index
            ].reshape(-1)

            image_labels = np.full(
                len(is_defective_patch),
                "nominal",
                dtype=object,
            )

            if defect_type != "good":
                image_labels[is_defective_patch] = defect_type

            feature_batches.append(
                embeddings[image_index]
            )
            label_batches.append(image_labels)

            for patch_index, patch_label in enumerate(image_labels):
                patch_row = patch_index // patch_width
                patch_column = patch_index % patch_width
                metadata_rows.append(
                    {
                        "global_image_index": global_image_index,
                        "batch_index": batch_index,
                        "image_index_in_batch": image_index,
                        "patch_index": patch_index,
                        "patch_row": patch_row,
                        "patch_column": patch_column,
                        "source_image_anomaly": defect_type,
                        "true_patch_class": patch_label,
                    }
                )

            global_image_index += 1

        if (batch_index + 1) % 10 == 0 or batch_index + 1 == len(test_loader):
            print(
                f"[test features] "
                f"{batch_index + 1}/{len(test_loader)}"
            )

    features = np.concatenate(
        feature_batches,
        axis=0,
    ).astype(np.float32)
    labels = np.concatenate(label_batches).astype(str)
    metadata = pd.DataFrame(metadata_rows)

    return features, labels, metadata


def sample_clustering_input(
    features: np.ndarray,
    labels: np.ndarray,
    metadata: pd.DataFrame,
    max_per_class: int,
    balanced: bool,
    seed: int,
) -> Tuple[np.ndarray, np.ndarray, pd.DataFrame]:
    """
    Select the patch set used by K-Means.

    balanced=True:
        Use the same number of patches for every class. This prevents nominal
        patches from dominating the clustering objective.

    balanced=False:
        Keep up to max_per_class patches independently from each class.
    """
    rng = np.random.default_rng(seed)
    unique_labels = sorted(np.unique(labels).tolist())

    class_indices = {
        label: np.flatnonzero(labels == label)
        for label in unique_labels
    }

    if balanced:
        smallest_class = min(
            len(indices)
            for indices in class_indices.values()
        )
        target_per_class = smallest_class
        if max_per_class > 0:
            target_per_class = min(
                target_per_class,
                max_per_class,
            )
    else:
        target_per_class = max_per_class

    selected_parts: List[np.ndarray] = []

    for label in unique_labels:
        indices = class_indices[label]

        if balanced:
            target = target_per_class
        else:
            target = (
                len(indices)
                if max_per_class <= 0
                else min(max_per_class, len(indices))
            )

        if len(indices) > target:
            selected = rng.choice(
                indices,
                size=target,
                replace=False,
            )
        else:
            selected = indices

        selected_parts.append(
            np.asarray(selected, dtype=np.int64)
        )

    selected_indices = np.concatenate(selected_parts)
    rng.shuffle(selected_indices)

    selected_metadata = metadata.iloc[
        selected_indices
    ].copy().reset_index(drop=True)
    selected_metadata["original_test_patch_row"] = selected_indices

    return (
        features[selected_indices],
        labels[selected_indices],
        selected_metadata,
    )


def clustering_accuracy(
    true_labels: np.ndarray,
    cluster_labels: np.ndarray,
) -> float:
    """
    Hungarian-matched clustering accuracy.

    When k differs from the number of true classes, the mapping is necessarily
    imperfect. The metric is still reported, but ARI/NMI are more appropriate
    for comparing different k values.
    """
    true_values, true_encoded = np.unique(
        true_labels,
        return_inverse=True,
    )
    cluster_values, cluster_encoded = np.unique(
        cluster_labels,
        return_inverse=True,
    )

    matrix = np.zeros(
        (len(true_values), len(cluster_values)),
        dtype=np.int64,
    )

    for true_id, cluster_id in zip(
        true_encoded,
        cluster_encoded,
    ):
        matrix[true_id, cluster_id] += 1

    row_ind, col_ind = linear_sum_assignment(
        matrix.max() - matrix
    )

    return float(
        matrix[row_ind, col_ind].sum()
        / max(len(true_labels), 1)
    )


def cluster_purity(
    true_labels: np.ndarray,
    cluster_labels: np.ndarray,
) -> float:
    total_correct = 0

    for cluster_id in np.unique(cluster_labels):
        labels_in_cluster = true_labels[
            cluster_labels == cluster_id
        ]
        _, counts = np.unique(
            labels_in_cluster,
            return_counts=True,
        )
        total_correct += counts.max()

    return float(
        total_correct / max(len(true_labels), 1)
    )


def safe_silhouette(
    features: np.ndarray,
    cluster_labels: np.ndarray,
    sample_size: int,
    seed: int,
) -> float:
    if len(np.unique(cluster_labels)) < 2:
        return float("nan")

    effective_sample_size = min(
        sample_size,
        len(features),
    )

    return float(
        silhouette_score(
            features,
            cluster_labels,
            metric="euclidean",
            sample_size=effective_sample_size,
            random_state=seed,
        )
    )


def make_contingency_tables(
    true_labels: np.ndarray,
    cluster_labels: np.ndarray,
) -> Tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame, pd.DataFrame]:
    assignments = pd.DataFrame(
        {
            "True Class": true_labels,
            "Cluster": cluster_labels,
        }
    )

    class_to_cluster_counts = pd.crosstab(
        assignments["True Class"],
        assignments["Cluster"],
    )

    class_to_cluster_percent = pd.crosstab(
        assignments["True Class"],
        assignments["Cluster"],
        normalize="index",
    ) * 100.0

    cluster_composition_counts = pd.crosstab(
        assignments["Cluster"],
        assignments["True Class"],
    )

    cluster_composition_percent = pd.crosstab(
        assignments["Cluster"],
        assignments["True Class"],
        normalize="index",
    ) * 100.0

    return (
        class_to_cluster_counts,
        class_to_cluster_percent,
        cluster_composition_counts,
        cluster_composition_percent,
    )


def annotate_heatmap(
    axis,
    values: np.ndarray,
    fmt: str,
) -> None:
    for row in range(values.shape[0]):
        for column in range(values.shape[1]):
            axis.text(
                column,
                row,
                format(values[row, column], fmt),
                ha="center",
                va="center",
                fontsize=8,
            )


def save_heatmap(
    table: pd.DataFrame,
    title: str,
    x_label: str,
    y_label: str,
    output_path: Path,
    percentage: bool,
) -> None:
    values = table.to_numpy(dtype=float)

    figure_width = max(
        8.0,
        1.25 * len(table.columns) + 3.0,
    )
    figure_height = max(
        5.0,
        0.65 * len(table.index) + 2.5,
    )

    plt.figure(
        figsize=(figure_width, figure_height)
    )
    axis = plt.gca()
    image = axis.imshow(
        values,
        aspect="auto",
    )

    axis.set_xticks(
        np.arange(len(table.columns))
    )
    axis.set_xticklabels(
        [str(value) for value in table.columns]
    )
    axis.set_yticks(
        np.arange(len(table.index))
    )
    axis.set_yticklabels(
        [str(value) for value in table.index]
    )

    axis.set_xlabel(x_label)
    axis.set_ylabel(y_label)
    axis.set_title(title)

    annotate_heatmap(
        axis,
        values,
        ".1f" if percentage else ".0f",
    )

    colorbar = plt.colorbar(
        image,
        ax=axis,
    )
    colorbar.set_label(
        "Percent" if percentage else "Patch count"
    )

    plt.tight_layout()
    plt.savefig(output_path, dpi=180)
    plt.close()


def save_scatter_plot(
    features_2d: np.ndarray,
    labels: np.ndarray,
    title: str,
    output_path: Path,
    label_name: str,
    point_size: float,
    alpha: float,
) -> None:
    plt.figure(figsize=(10, 8))

    unique_labels = sorted(
        np.unique(labels).tolist(),
        key=str,
    )

    for label in unique_labels:
        mask = labels == label
        plt.scatter(
            features_2d[mask, 0],
            features_2d[mask, 1],
            s=point_size,
            alpha=alpha,
            label=str(label),
        )

    plt.xlabel("Visualization PCA component 1")
    plt.ylabel("Visualization PCA component 2")
    plt.title(title)
    plt.legend(
        title=label_name,
        frameon=True,
        markerscale=2,
    )
    plt.tight_layout()
    plt.savefig(output_path, dpi=180)
    plt.close()


def save_combined_scatter(
    features_2d: np.ndarray,
    true_labels: np.ndarray,
    cluster_labels: np.ndarray,
    title: str,
    output_path: Path,
    point_size: float,
    alpha: float,
) -> None:
    figure, axes = plt.subplots(
        1,
        2,
        figsize=(18, 7),
    )

    for label in sorted(
        np.unique(true_labels).tolist(),
        key=str,
    ):
        mask = true_labels == label
        axes[0].scatter(
            features_2d[mask, 0],
            features_2d[mask, 1],
            s=point_size,
            alpha=alpha,
            label=str(label),
        )

    axes[0].set_title("Ground-truth patch classes")
    axes[0].set_xlabel("Visualization PCA component 1")
    axes[0].set_ylabel("Visualization PCA component 2")
    axes[0].legend(
        title="True class",
        markerscale=2,
