        markerscale=2,
    )

    figure.suptitle(title)
    figure.tight_layout()
    figure.savefig(output_path, dpi=180)
    plt.close(figure)


def fit_cluster_model(
    features: np.ndarray,
    number_of_clusters: int,
    algorithm: str,
    seed: int,
    max_iter: int,
    n_init: int,
    minibatch_size: int,
):
    if algorithm == "kmeans":
        model = KMeans(
            n_clusters=number_of_clusters,
            random_state=seed,
            n_init=n_init,
            max_iter=max_iter,
        )
    elif algorithm == "minibatch_kmeans":
        model = MiniBatchKMeans(
            n_clusters=number_of_clusters,
            random_state=seed,
            n_init=n_init,
            max_iter=max_iter,
            batch_size=minibatch_size,
            reassignment_ratio=0.01,
        )
    else:
        raise ValueError(
            f"Unsupported clustering algorithm: {algorithm}"
        )

    cluster_labels = model.fit_predict(features)
    return model, cluster_labels


def run_category(
    category: str,
    model,
    data_root: Path,
    output_dir: Path,
    args,
    device: torch.device,
) -> pd.DataFrame:
    print(
        f"\n{'=' * 88}\n"
        f"CATEGORY: {category}\n"
        f"{'=' * 88}"
    )

    category_dir = output_dir / category
    category_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    (
        train_dataset,
        test_dataset,
        train_loader,
        test_loader,
    ) = build_loaders(
        data_root=data_root,
        category=category,
        batch_size=args.batch_size,
        num_workers=args.num_workers,
        seed=args.seed,
    )

    print(
        f"Training images: {len(train_dataset)}"
    )
    print(
        f"Testing images: {len(test_dataset)}"
    )

    all_nominal_train = collect_nominal_training_features(
        model,
        train_loader,
    )

    selected_nominal_train, selected_indices = (
        subsample_nominal_reference(
            features=all_nominal_train,
            mode=args.subsampling,
            percentage=args.subsample_percentage,
            max_patches=args.max_train_patches,
            seed=args.seed,
            device=device,
        )
    )

    np.save(
        category_dir / "selected_reference_indices.npy",
        selected_indices,
    )

    print(
        f"All nominal training patches: "
        f"{all_nominal_train.shape}"
    )
    print(
        f"Selected nominal PCA reference: "
        f"{selected_nominal_train.shape}"
    )

    pca_components = min(
        args.pca_dim,
        selected_nominal_train.shape[0],
        selected_nominal_train.shape[1],
    )

    if pca_components < 2:
        raise RuntimeError(
            "PCA needs at least two components."
        )

    pca_model = PCA(
        n_components=pca_components,
        random_state=args.seed,
    )

    pca_start = time.perf_counter()
    pca_model.fit(selected_nominal_train)
    pca_fit_seconds = (
        time.perf_counter() - pca_start
    )

    joblib.dump(
        pca_model,
        category_dir / "pca_model.joblib",
    )

    pca_summary = {
        "category": category,
        "input_dimension": int(
            selected_nominal_train.shape[1]
        ),
        "pca_dimension": int(pca_components),
        "explained_variance_ratio_sum": float(
            pca_model.explained_variance_ratio_.sum()
        ),
        "pca_fit_seconds": float(pca_fit_seconds),
        "subsampling": args.subsampling,
        "selected_nominal_patch_count": int(
            len(selected_nominal_train)
        ),
    }

    (
        category_dir / "pca_summary.json"
    ).write_text(
        json.dumps(pca_summary, indent=2)
    )

    test_features, test_labels, test_metadata = (
        collect_test_features_and_labels(
            model=model,
            test_loader=test_loader,
            anomaly_fraction_threshold=(
                args.anomaly_fraction_threshold
            ),
        )
    )

    (
        clustering_original_features,
        clustering_true_labels,
        clustering_metadata,
    ) = sample_clustering_input(
        features=test_features,
        labels=test_labels,
        metadata=test_metadata,
        max_per_class=args.max_patches_per_class,
        balanced=args.balanced_classes,
        seed=args.seed,
    )

    clustering_pca_features = pca_model.transform(
        clustering_original_features
    ).astype(np.float32)

    class_counts = pd.Series(
        clustering_true_labels
    ).value_counts().sort_index()

    print("Clustering patch counts by class:")
    print(class_counts.to_string())

    input_table = clustering_metadata.copy()
    input_table["true_class"] = (
        clustering_true_labels
    )

    for component_index in range(
        clustering_pca_features.shape[1]
    ):
        input_table[
            f"pca_{component_index + 1}"
        ] = clustering_pca_features[
            :,
            component_index,
        ]

    input_table.to_csv(
        category_dir / "clustering_input.csv",
        index=False,
    )

    # A separate two-dimensional PCA is fitted only for visualization.
    visualization_pca = PCA(
        n_components=2,
        random_state=args.seed,
    )
    visualization_features = (
        visualization_pca.fit_transform(
            clustering_pca_features
        )
    )

    joblib.dump(
        visualization_pca,
        category_dir / "pca_2d_visualizer.joblib",
    )

    save_scatter_plot(
        features_2d=visualization_features,
        labels=clustering_true_labels,
        title=(
            f"{category}: true patch classes "
            f"after {pca_components}-D nominal-trained PCA"
        ),
        output_path=(
            category_dir
            / "all_true_classes_scatter.png"
        ),
        label_name="True class",
        point_size=args.scatter_point_size,
        alpha=args.scatter_alpha,
    )

    summary_rows: List[Dict[str, object]] = []

    true_class_count = len(
        np.unique(clustering_true_labels)
    )

    for number_of_clusters in range(
        args.min_clusters,
        args.max_clusters + 1,
    ):
        print(
            f"\n[{category}] Clustering with "
            f"k={number_of_clusters}"
        )

        k_dir = category_dir / f"k_{number_of_clusters}"
        k_dir.mkdir(
            parents=True,
            exist_ok=True,
        )

        fit_start = time.perf_counter()
        cluster_model, cluster_labels = (
            fit_cluster_model(
                features=clustering_pca_features,
                number_of_clusters=(
                    number_of_clusters
                ),
                algorithm=args.cluster_algorithm,
                seed=args.seed,
                max_iter=args.cluster_max_iter,
                n_init=args.cluster_n_init,
                minibatch_size=(
                    args.minibatch_size
                ),
            )
        )
        fit_seconds = (
            time.perf_counter() - fit_start
        )

        joblib.dump(
            cluster_model,
            k_dir / "cluster_model.joblib",
        )

        (
            class_to_cluster_counts,
            class_to_cluster_percent,
            cluster_composition_counts,
            cluster_composition_percent,
        ) = make_contingency_tables(
            clustering_true_labels,
            cluster_labels,
        )

        class_to_cluster_counts.to_csv(
            k_dir / "class_to_cluster_counts.csv"
        )
        class_to_cluster_percent.to_csv(
            k_dir / "class_to_cluster_percent.csv"
        )
        cluster_composition_counts.to_csv(
            k_dir / "cluster_composition_counts.csv"
        )
        cluster_composition_percent.to_csv(
            k_dir / "cluster_composition_percent.csv"
        )

        assignments = clustering_metadata.copy()
        assignments["true_class"] = (
            clustering_true_labels
        )
        assignments["cluster"] = cluster_labels
        assignments.to_csv(
            k_dir / "assignments.csv",
            index=False,
        )

        metrics = {
            "category": category,
            "number_of_clusters": int(
                number_of_clusters
            ),
            "number_of_true_classes": int(
                true_class_count
            ),
            "patch_count": int(
                len(clustering_pca_features)
            ),
            "pca_dimension": int(
                clustering_pca_features.shape[1]
            ),
            "algorithm": args.cluster_algorithm,
            "fit_seconds": float(fit_seconds),
            "inertia": float(
                cluster_model.inertia_
            ),
            "adjusted_rand_index": float(
                adjusted_rand_score(
                    clustering_true_labels,
                    cluster_labels,
                )
            ),
            "adjusted_mutual_information": float(
                adjusted_mutual_info_score(
                    clustering_true_labels,
                    cluster_labels,
                )
            ),
            "normalized_mutual_information": float(
                normalized_mutual_info_score(
                    clustering_true_labels,
                    cluster_labels,
                )
            ),
            "homogeneity": float(
                homogeneity_score(
                    clustering_true_labels,
                    cluster_labels,
                )
            ),
            "completeness": float(
                completeness_score(
                    clustering_true_labels,
                    cluster_labels,
                )
            ),
            "v_measure": float(
                v_measure_score(
                    clustering_true_labels,
                    cluster_labels,
                )
            ),
            "hungarian_accuracy": float(
                clustering_accuracy(
                    clustering_true_labels,
                    cluster_labels,
                )
            ),
            "purity": float(
                cluster_purity(
                    clustering_true_labels,
                    cluster_labels,
                )
            ),
            "silhouette": float(
                safe_silhouette(
                    clustering_pca_features,
                    cluster_labels,
                    sample_size=(
                        args.silhouette_sample_size
                    ),
                    seed=args.seed,
                )
            ),
            "calinski_harabasz": float(
                calinski_harabasz_score(
                    clustering_pca_features,
                    cluster_labels,
                )
            ),
            "davies_bouldin": float(
                davies_bouldin_score(
                    clustering_pca_features,
                    cluster_labels,
                )
            ),
        }

        (
            k_dir / "metrics.json"
        ).write_text(
            json.dumps(metrics, indent=2)
        )

        summary_rows.append(metrics)

        save_heatmap(
            table=class_to_cluster_percent,
            title=(
                f"{category}, k={number_of_clusters}: "
                f"where each true class is assigned"
            ),
            x_label="Cluster",
            y_label="True patch class",
            output_path=(
                k_dir
                / "class_to_cluster_heatmap.png"
            ),
            percentage=True,
        )

        save_heatmap(
            table=cluster_composition_percent,
            title=(
                f"{category}, k={number_of_clusters}: "
                f"composition of every cluster"
            ),
            x_label="True patch class",
            y_label="Cluster",
            output_path=(
                k_dir
                / "cluster_composition_heatmap.png"
            ),
            percentage=True,
        )

        save_scatter_plot(
            features_2d=visualization_features,
            labels=cluster_labels.astype(str),
            title=(
                f"{category}: K-Means clusters "
                f"(k={number_of_clusters})"
            ),
            output_path=(
                k_dir / "scatter_clusters.png"
            ),
            label_name="Cluster",
            point_size=args.scatter_point_size,
            alpha=args.scatter_alpha,
        )

        save_scatter_plot(
            features_2d=visualization_features,
            labels=clustering_true_labels,
            title=(
                f"{category}: ground-truth classes "
                f"for k={number_of_clusters} comparison"
            ),
            output_path=(
                k_dir
                / "scatter_true_classes.png"
            ),
            label_name="True class",
            point_size=args.scatter_point_size,
            alpha=args.scatter_alpha,
        )

        save_combined_scatter(
            features_2d=visualization_features,
            true_labels=clustering_true_labels,
            cluster_labels=cluster_labels,
            title=(
                f"{category}: true classes versus "
                f"K-Means clusters, k={number_of_clusters}"
            ),
            output_path=(
                k_dir
                / "scatter_true_vs_clusters.png"
            ),
            point_size=args.scatter_point_size,
            alpha=args.scatter_alpha,
        )

        print(
            pd.Series(metrics).to_string()
        )

    category_summary = pd.DataFrame(
        summary_rows
    ).sort_values(
        "number_of_clusters"
    )

    category_summary.to_csv(
        category_dir / "cluster_summary.csv",
        index=False,
    )

    category_run_config = {
        "category": category,
        "subsampling": args.subsampling,
        "subsample_percentage": (
            args.subsample_percentage
        ),
        "max_train_patches": (
            args.max_train_patches
        ),
        "pca_dimension": pca_components,
        "balanced_classes": (
            args.balanced_classes
        ),
        "max_patches_per_class": (
            args.max_patches_per_class
        ),
        "min_clusters": args.min_clusters,
        "max_clusters": args.max_clusters,
        "cluster_algorithm": (
            args.cluster_algorithm
        ),
        "seed": args.seed,
        "true_classes": sorted(
            np.unique(
                clustering_true_labels
            ).tolist()
        ),
        "class_counts": {
            str(key): int(value)
            for key, value in class_counts.items()
        },
    }

    (
        category_dir / "run_config.json"
    ).write_text(
        json.dumps(
            category_run_config,
            indent=2,
        )
    )

    return category_summary


def create_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "Fit nominal-trained PCA and evaluate K-Means "
            "cluster structure for MVTec test patches."
        )
    )

    parser.add_argument(
        "--repo-root",
        type=Path,
        required=True,
    )
    parser.add_argument(
        "--data-root",
        type=Path,
        required=True,
    )
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=Path(
            "pca_clustering_results"
        ),
    )
    parser.add_argument(
        "--categories",
        nargs="+",
        default=list(DEFAULT_CATEGORIES),
        choices=MVTEC_CATEGORIES,
        help=(
            "One or more MVTec categories. "
            "Default: bottle capsule grid."
        ),
    )

    parser.add_argument(
        "--subsampling",
        choices=("coreset", "random", "none"),
        default="coreset",
        help=(
            "Nominal training reference selection used "
            "before fitting PCA."
        ),
    )
    parser.add_argument(
        "--subsample-percentage",
        type=float,
        default=0.1,
    )
    parser.add_argument(
        "--max-train-patches",
        type=int,
        default=30000,
    )
    parser.add_argument(
        "--pca-dim",
        type=int,
        default=64,
    )

    parser.add_argument(
        "--min-clusters",
        type=int,
        default=2,
    )
    parser.add_argument(
        "--max-clusters",
        type=int,
        default=6,
    )
    parser.add_argument(
        "--cluster-algorithm",
        choices=("kmeans", "minibatch_kmeans"),
        default="kmeans",
    )
    parser.add_argument(
        "--cluster-max-iter",
        type=int,
        default=300,
    )
    parser.add_argument(
        "--cluster-n-init",
        type=int,
        default=20,
    )
    parser.add_argument(
        "--minibatch-size",
        type=int,
        default=2048,
    )

    parser.add_argument(
        "--balanced-classes",
        action=argparse.BooleanOptionalAction,
        default=True,
        help=(
            "Use equal patch counts for nominal and every "
            "defect type before clustering. Default: true."
        ),
    )
    parser.add_argument(
        "--max-patches-per-class",
        type=int,
        default=2000,
        help=(
            "Maximum clustering patches retained per true "
            "class. With balanced classes, every class uses "
            "the same count up to this maximum."
        ),
    )

    parser.add_argument(
        "--anomaly-fraction-threshold",
        type=float,
        default=0.10,
    )
    parser.add_argument(
        "--silhouette-sample-size",
        type=int,
        default=5000,
    )
    parser.add_argument(
        "--scatter-point-size",
        type=float,
        default=10.0,
    )
    parser.add_argument(
        "--scatter-alpha",
        type=float,
        default=0.35,
    )

    parser.add_argument(
        "--batch-size",
        type=int,
        default=2,
    )
    parser.add_argument(
        "--num-workers",
        type=int,
        default=2,
    )
    parser.add_argument(
        "--device",
        default="auto",
    )
    parser.add_argument(
        "--seed",
        type=int,
        default=0,
    )

    return parser


def validate_arguments(args) -> None:
    if not 0 < args.subsample_percentage <= 1:
        raise ValueError(
            "--subsample-percentage must be in (0, 1]."
        )

    if args.pca_dim < 2:
        raise ValueError(
            "--pca-dim must be at least 2."
        )

    if args.min_clusters < 2:
        raise ValueError(
            "--min-clusters must be at least 2."
        )

    if args.max_clusters < args.min_clusters:
        raise ValueError(
            "--max-clusters must be >= --min-clusters."
        )

    if args.max_patches_per_class == 0:
        raise ValueError(
            "--max-patches-per-class must be positive "
            "or negative for no cap."
        )

    if not 0 < args.anomaly_fraction_threshold <= 1:
        raise ValueError(
            "--anomaly-fraction-threshold must be in (0, 1]."
        )


def main() -> None:
    parser = create_parser()
    args = parser.parse_args()
    validate_arguments(args)

    set_seed(args.seed)
    device = resolve_device(args.device)

    repo_root = args.repo_root.resolve()
    data_root = args.data_root.resolve()
    output_dir = args.output_dir.resolve()
    output_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    add_repo_src(repo_root)

    global_config = vars(args).copy()
    global_config.update(
        {
            "repo_root": str(repo_root),
            "data_root": str(data_root),
            "output_dir": str(output_dir),
            "device": str(device),
        }
    )

    (
        output_dir / "run_config.json"
    ).write_text(
        json.dumps(
            global_config,
            indent=2,
            default=str,
        )
    )

    print(
        json.dumps(
            global_config,
            indent=2,
            default=str,
        )
    )

    patchcore_model = build_patchcore_model(
        device
    )

    all_category_summaries: List[pd.DataFrame] = []

    for category in args.categories:
        try:
            category_summary = run_category(
                category=category,
                model=patchcore_model,
                data_root=data_root,
                output_dir=output_dir,
                args=args,
                device=device,
            )
            all_category_summaries.append(
                category_summary
            )
        except Exception as error:
            category_dir = output_dir / category
            category_dir.mkdir(
                parents=True,
                exist_ok=True,
            )
            error_record = {
                "category": category,
                "error_type": type(error).__name__,
                "message": str(error),
            }
            (
                category_dir / "error.json"
            ).write_text(
                json.dumps(
                    error_record,
                    indent=2,
                )
            )
            print(
                f"[ERROR] {category}: "
                f"{type(error).__name__}: {error}"
            )

    if not all_category_summaries:
        raise RuntimeError(
            "Every category failed. Check category error.json files."
        )

    combined_summary = pd.concat(
        all_category_summaries,
        ignore_index=True,
    )

    combined_summary.to_csv(
        output_dir
        / "all_categories_cluster_summary.csv",
        index=False,
    )

    best_by_silhouette = (
        combined_summary
        .sort_values(
            ["category", "silhouette"],
            ascending=[True, False],
        )
        .groupby(
            "category",
            as_index=False,
        )
        .first()
    )

    best_by_ari = (
        combined_summary
        .sort_values(
            [
                "category",
                "adjusted_rand_index",
            ],
            ascending=[True, False],
        )
        .groupby(
            "category",
            as_index=False,
        )
        .first()
    )

    best_by_silhouette.to_csv(
        output_dir / "best_k_by_silhouette.csv",
        index=False,
    )
    best_by_ari.to_csv(
        output_dir / "best_k_by_ari.csv",
        index=False,
    )

    print("\nBEST K BY SILHOUETTE")
    print(
        best_by_silhouette[
            [
                "category",
                "number_of_clusters",
                "silhouette",
                "adjusted_rand_index",
                "normalized_mutual_information",
            ]
        ].round(4).to_string(index=False)
    )

    print("\nBEST K BY ARI")
    print(
        best_by_ari[
            [
                "category",
                "number_of_clusters",
                "adjusted_rand_index",
                "normalized_mutual_information",
                "silhouette",
            ]
        ].round(4).to_string(index=False)
    )

    print(
        f"\nFinished. Outputs: {output_dir}"
    )


if __name__ == "__main__":
    main()
